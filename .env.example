# Configure application variables in cPanel's Node.js application environment.
# This file contains examples only. Never copy real values into source control.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=https://example.invalid

# Required: URL-encode special characters in the username and password.
DATABASE_URL=mysql://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:3306/DB_NAME

# Required: replace with a private random value of at least 32 bytes.
SESSION_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_OF_32_OR_MORE_BYTES

# Optional persistent storage root. If unset, files use <application-root>/storage/.
# Set an absolute server path; uploads/ and receipts/ subfolders are created beneath it.
# Example only: /absolute/path/to/nahuda-sewa-storage
STORAGE_ROOT=

# Optional rate/session tuning. Defaults shown are from src/config/env.js.
SESSION_LIFETIME_MINUTES=480
LOGIN_WINDOW_MINUTES=15
LOGIN_IP_MAX=20
LOGIN_ACCOUNT_MAX=10
RECEIPT_WINDOW_MINUTES=60
RECEIPT_IP_MAX=10
RECEIPT_EMAIL_MAX=5
CONTACT_WINDOW_MINUTES=60
CONTACT_IP_MAX=10
CONTACT_EMAIL_MAX=5

# Only for the one-time npm run admin:create operation; leave blank otherwise.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
