<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="page-width organization-page media-page gallery-experience" tabindex="-1">
<% if(!album) { %><header class="organization-heading"><p class="eyebrow"><%= t.media %></p><h1><%= heading %></h1></header><% } %>
<nav class="organization-links" aria-label="<%= t.media %>"><% for(const item of ['news','gallery','testimonials']) { %><a class="button-secondary" href="<%= localePrefix+'/'+item %>" <%= item==='gallery'?'aria-current=page':'' %>><%= t[item] %></a><% } %></nav>
<% if(album) { %><%- include('gallery/album-detail') %><% } else { %><%- include('gallery/album-grid') %><% } %>
</main>
<script src="/assets/js/gallery.js" defer></script>
<%- include('../partials/footer') %>
