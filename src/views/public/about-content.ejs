<header class="about-hero <%= row?.hero_image?'about-hero-with-image':'about-hero-default' %>">
  <% if(row?.hero_image) { %><img class="about-hero-background" src="<%= assetUrl(row.hero_image) %>" width="<%= row.hero_image.width %>" height="<%= row.hero_image.height %>" alt="" fetchpriority="high"><% } %>
  <div class="about-hero-content"><p class="eyebrow"><%= t.about %></p><h1><%= heading %></h1><span class="about-hero-accent" aria-hidden="true"></span></div>
</header>
<nav class="organization-links" aria-label="<%= t.about %>"><a class="button-secondary" href="<%= localePrefix %>/about" aria-current="page"><%= t.organization %></a><a class="button-secondary" href="<%= localePrefix %>/about/team"><%= t.team %></a><a class="button-secondary" href="<%= localePrefix %>/about/committee"><%= t.committee %></a></nav>
<% if(row) { const leadImage=row.images[0]; %>
  <section class="about-intro-split" aria-labelledby="about-introduction-heading"><div class="about-intro-copy"><p class="eyebrow"><%= t.organization %></p><h2 id="about-introduction-heading" class="about-section-title"><%= labels.introduction %></h2><p class="preserve-lines"><%= contentText(row,'introduction',locale) %></p></div>
    <% if(leadImage) { %><figure class="about-lead-visual"><img src="<%= assetUrl(leadImage.media) %>" alt="<%= contentText(leadImage,'alt_text',locale) %>" width="<%= leadImage.media.width %>" height="<%= leadImage.media.height %>" loading="lazy" decoding="async"></figure><% } else { %><div class="about-brand-visual"><% if(organization.primary_logo) { %><img src="<%= organization.primary_logo %>" alt="" width="240" height="240" loading="lazy"><% } %><p><%= organization.name %></p><% if(organization.tagline) { %><p class="text-muted"><%= organization.tagline %></p><% } %></div><% } %>
  </section>
  <div class="about-history-layout <%= video?'about-history-with-video':'' %>">
  <section class="about-history organization-card"><p class="eyebrow">01</p><h2><%= labels.history %></h2><p class="preserve-lines"><%= contentText(row,'background_history',locale) %></p></section>
<% if(video) { %><section class="about-video" aria-labelledby="video-heading"><div class="about-video-heading"><h2 id="video-heading" class="about-section-title"><%= labels.video %></h2><a class="button-secondary" href="<%= video.watch %>" target="_blank" rel="noopener noreferrer"><%= labels.watch %> ↗</a></div><div class="about-video-frame"><iframe src="<%= video.embed %>" title="<%= labels.video %>" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe></div></section><% } %>
  </div>
<% } else { %><p class="form-alert"><%= labels.empty %></p><% } %>
<section id="vision-mission" class="about-purpose" aria-labelledby="purpose-heading"><h2 id="purpose-heading" class="about-section-title"><%= t.vision %></h2><% if(vision) { %><div class="about-purpose-grid"><% for(const field of ['vision','mission']) { %><section class="organization-card about-purpose-card"><p class="eyebrow"><%= labels[field] %></p><h3><%= labels[field] %></h3><p class="preserve-lines"><%= contentText(vision,field,locale) %></p></section><% } %></div><% } else { %><p class="text-muted"><%= labels.empty %></p><% } %></section>
<% if(row) { %><div class="about-principles"><% for(const [field,label,index] of [['objectives',labels.objectives,'02'],['core_values',labels.core_values,'03']]) { %><section class="organization-card"><p class="eyebrow"><%= index %></p><h2><%= label %></h2><p class="preserve-lines"><%= contentText(row,field,locale) %></p></section><% } %></div><% } %>
<% if(row && row.images.length>1) { %><div class="organization-images"><% for(const image of row.images.slice(1)) { %><figure><img src="<%= assetUrl(image.media) %>" alt="<%= contentText(image,'alt_text',locale) %>" width="<%= image.media.width %>" height="<%= image.media.height %>" loading="lazy" decoding="async"></figure><% } %></div><% } %>

<% if(row?.statistics.length) { %><section id="statistics" class="about-statistics" aria-labelledby="statistics-heading"><h2 id="statistics-heading" class="about-section-title"><%= labels.statistics %></h2><dl class="about-stat-grid"><% for(const stat of row.statistics) { %><div class="about-stat-card"><dt><%= contentText(stat,'label',locale) %></dt><dd><%= stat.value %></dd></div><% } %></dl></section><% } %>
