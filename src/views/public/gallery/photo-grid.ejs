<div class="gallery-photos <%= album.images.length===1?'gallery-single':album.images.length<=3?'gallery-few':'' %>">
<% for(const [index,image] of album.images.entries()) { const caption=contentText(image,'caption',locale),credit=contentText(image,'credit',locale); %>
<figure class="gallery-photo"><a class="gallery-photo-link gallery-image-shell" data-image-shell data-gallery-photo data-caption="<%= caption %>" data-credit="<%= credit %>" href="<%= assetUrl(image.image) %>" aria-label="<%= labels.open+': '+contentText(image,'alt_text',locale) %>"><span class="gallery-image-fallback"><%= labels.unavailable %></span><img class="gallery-load-image" src="<%= assetUrl(image.image) %>" width="<%= image.image.width %>" height="<%= image.image.height %>" alt="<%= contentText(image,'alt_text',locale) %>" loading="lazy" decoding="async"><span class="gallery-magnify" aria-hidden="true">⌕</span></a><% if(caption||credit) { %><figcaption><% if(caption) { %><span class="gallery-caption"><%= caption %></span><% } %><% if(credit) { %><span class="gallery-credit"><%= credit %></span><% } %></figcaption><% } %></figure>
<% } %></div>
