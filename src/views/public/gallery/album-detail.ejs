<a class="gallery-back text-link" href="<%= localePrefix %>/gallery"><span aria-hidden="true">←</span> <%= labels.back %></a>
<nav class="gallery-breadcrumb" aria-label="<%= locale==='ne'?'पृष्ठ मार्ग':'Breadcrumb' %>"><ol><li><a href="<%= homeUrl %>"><%= t.home %></a></li><li><a href="<%= localePrefix %>/gallery"><%= t.gallery %></a></li><li aria-current="page"><%= heading %></li></ol></nav>
<header class="gallery-detail-heading"><p class="eyebrow"><%= t.gallery %></p><h1><%= heading %></h1><div class="gallery-detail-meta"><% if(album.date) { %><time datetime="<%= dateInput(album.date) %>"><%= formatDate(album.date) %></time><% } %><span><%= album.images.length %> <%= album.images.length===1?labels.photo:labels.photos %></span></div><% if(contentText(album,'description',locale)) { %><p class="preserve-lines"><%= contentText(album,'description',locale) %></p><% } %></header>
<% if(album.images.length) { %><%- include('photo-grid') %><%- include('lightbox') %><% } else { %><p class="form-alert"><%= labels.noImages %></p><% } %>
