<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const others=typeof otherWork==='undefined'?[]:otherWork; const coreLabels=typeof activityLabels==='undefined'?{contact:locale==='ne'?'थप जानकारी चाहिन्छ?':'Need More Information?',contactLink:t.contact}:activityLabels; %>
<main id="main" class="page-width organization-page programs-page" tabindex="-1">
<% if(!row) { %>
  <header class="organization-heading"><p class="eyebrow"><%= labels.heading %></p><h1><%= heading %></h1><p><%= labels.intro %></p></header>
  <% if(!rows.length) { %><p class="program-empty"><%= labels.empty %></p><% } else { %><div class="program-grid">
    <% for(const program of rows) { const excerpt=programExcerpt(contentText(program,'full_description',locale),program.description_format,locale); %>
    <article class="program-card <%= program.featured_image?'':'program-card-text' %>"><a href="<%= localePrefix+'/programs/'+program.slug %>" aria-labelledby="program-title-<%= program.id %>">
      <% if(program.featured_image) { %><div class="program-card-image"><img src="<%= assetUrl(program.featured_image) %>" alt="" width="<%= program.featured_image.width %>" height="<%= program.featured_image.height %>" loading="lazy" decoding="async"></div><% } %>
      <div class="program-card-copy"><h2 id="program-title-<%= program.id %>"><%= contentText(program,'title',locale) %></h2><% if(excerpt) { %><p><%= excerpt %></p><% } %><span class="text-link"><%= labels.read %> <span aria-hidden="true">→</span></span></div>
    </a></article><% } %>
  </div><% } %>
<% } else { const additionalHeading=contentText(row,'additional_heading',locale).trim(); const additionalContent=contentText(row,'additional_content',locale).trim(); const richInformation=row.additional_format==='HTML'; const hasInformation=richInformation?Boolean(additionalContent):Boolean(additionalHeading && additionalContent); const informationRows=richInformation?[]:programInformationRows(additionalContent); const implementingPartners=informationRows.find(item=>/partner|साझेदार/i.test(item.label)); %>
  <header class="activity-hero activity-hero-navy program-hero">
    <div class="activity-hero-glow" aria-hidden="true"></div><span class="activity-hero-ghost" aria-hidden="true"><%= [...new Intl.Segmenter(locale,{granularity:'grapheme'}).segment(labels.heading)][0]?.segment||'' %></span>
    <div class="activity-hero-copy"><p class="eyebrow activity-hero-chip"><span aria-hidden="true"></span><%= labels.heading %></p><span class="activity-hero-accent" aria-hidden="true"></span><h1><%= heading %></h1>
    <nav class="activity-breadcrumb" aria-label="<%= labels.breadcrumb %>"><ol><li><a href="<%= homeUrl %>"><%= t.home %></a></li><li><span aria-hidden="true">/</span><a href="<%= localePrefix %>/programs"><%= labels.heading %></a></li><li><span aria-hidden="true">/</span><span aria-current="page"><%= heading %></span></li></ol></nav></div>
  </header>
  <article class="program-content-layout program-with-information">
    <div class="program-main"><% if(implementingPartners) { %><section class="program-main-detail" aria-label="<%= implementingPartners.label %>"><div class="program-detail-list" role="list"><div class="program-detail-row" role="listitem"><span class="program-detail-label"><%= implementingPartners.label %></span><span class="program-detail-value"><%= implementingPartners.value %></span></div></div></section><% } %><section aria-labelledby="program-description-heading"><h2 id="program-description-heading"><%= labels.about %></h2><div class="activity-prose"><%- activityDescription(contentText(row,'full_description',locale),row.description_format) %></div></section>
    <% if(row.featured_image) { %><figure class="program-featured"><a href="<%= assetUrl(row.featured_image) %>"><img src="<%= assetUrl(row.featured_image) %>" alt="<%= heading %>" width="<%= row.featured_image.width %>" height="<%= row.featured_image.height %>" decoding="async"></a></figure><% } %><%- include('program-gallery',{programImages:row.images||[]}) %></div>
    <aside class="program-sidebar"><% if(hasInformation) { %><section class="program-information" aria-label="<%= richInformation?(locale==='ne'?'थप जानकारी':'Additional information'):additionalHeading %>"><% if(richInformation) { %><div class="activity-prose"><%- activityDescription(additionalContent,'HTML') %></div><% } else { %><h2 id="program-information-heading"><%= additionalHeading %></h2><div class="program-detail-list" role="list"><% for(const item of informationRows) { %><div class="program-detail-row <%= item.label?'':'program-detail-note' %>" role="listitem"><% if(item.label) { %><span class="program-detail-label"><%= item.label %></span><% } %><span class="program-detail-value"><%= item.value %></span></div><% } %></div><% } %></section><% } %>
<section class="program-information activity-related"><h2><%= labels.other %></h2><ul><% for(const item of others) { %><li><a href="<%= localePrefix+'/programs/'+item.slug %>"><%= contentText(item,'title',locale) %></a></li><% } %></ul></section>
<section class="program-information service-contact"><h2><%= coreLabels.contact %></h2><a class="button-primary" href="<%= localePrefix %>/contact"><%= coreLabels.contactLink %> ↗</a></section></aside>
  </article>
  <p class="program-return"><a class="text-link" href="<%= localePrefix %>/programs">← <%= labels.back %></a></p>
<% } %>
</main>
<%- include('../partials/footer') %>
