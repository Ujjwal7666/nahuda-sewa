<section class="home-section home-services page-width" aria-labelledby="home-services-heading">
<header class="home-section-heading"><div><p class="eyebrow"><%= t.services %></p><h2 id="home-services-heading"><%= home.coreActivities %></h2><p class="text-muted"><%= home.coreActivitiesIntro %></p></div></header>
<div class="service-showcase-grid"><% for(const group of serviceGroups) { const categoryName=group.category?contentText(group.category,'name',locale):serviceLabels.other; %>
<article class="service-category-card">
<% if(group.coverService) { %><a class="service-category-cover" href="<%= localePrefix+group.path %>" aria-hidden="true" tabindex="-1"><img src="<%= assetUrl(group.coverService.featured_image) %>" alt="" width="<%= group.coverService.featured_image.width %>" height="<%= group.coverService.featured_image.height %>" loading="lazy" decoding="async"></a><% } else { %><div class="service-category-art" aria-hidden="true"><span>✦</span></div><% } %>
<details class="home-category-details"><summary class="home-category-summary"><p class="eyebrow"><%= serviceLabels.category %></p><h3><a href="<%= localePrefix+group.path %>"><%= categoryName %></a></h3>
<% if(group.category && contentText(group.category,'description',locale)) { %><p class="service-category-description"><%= contentText(group.category,'description',locale) %></p><% } %>
<span class="home-category-count"><%= group.services.length %> <%= home.activityCount %></span><span class="home-category-indicator" aria-hidden="true">⌄</span></summary>
<div class="home-category-expanded"><div><ul class="service-category-preview" aria-label="<%= categoryName %>"><% for(const service of group.services) { %><li><a href="<%= localePrefix+'/services/'+service.slug %>"><span><% if(service.icon) { %><span aria-hidden="true"><%= service.icon %> </span><% } %><%= contentText(service,'name',locale) %></span><span aria-hidden="true">↗</span></a><% if(contentText(service,'short_description',locale)) { %><p class="home-service-summary"><%= homeExcerpt(contentText(service,'short_description',locale),120,locale) %></p><% } %></li><% } %></ul>
<a class="text-link service-card-cta" href="<%= localePrefix+group.path %>" aria-label="<%= home.viewCategory+': '+categoryName %>"><%= home.viewCategory %><span aria-hidden="true"> →</span></a></div></div></details></article>
<% } %></div><p class="home-work-all"><a class="button-secondary" href="<%= localePrefix %>/services"><%= home.exploreAllActivities %><span aria-hidden="true"> →</span></a></p></section>
