<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="home-page" tabindex="-1">
  <section class="welcome-section page-width home-hero" aria-labelledby="welcome-heading">
    <div class="welcome-copy" data-home-reveal>
      <span class="preview-label"><span class="status-dot" aria-hidden="true"></span><%= home.welcome %></span>
      <p class="eyebrow mt-6"><%= organization.short_name || name %></p>
      <h1 id="welcome-heading" class="welcome-heading"><%= name %></h1>
      <% if(organization.tagline) { %><p class="home-hero-tagline"><%= organization.tagline %></p><% } %>
      <% const heroIntro=contentText(about,'introduction',locale)||organization.footer_description; if(heroIntro) { %><p class="welcome-intro"><%= homeExcerpt(heroIntro,220,locale) %></p><% } %>
      <div class="home-actions"><a class="button-primary" href="<%= localePrefix %>/services"><%= home.services %><span aria-hidden="true">→</span></a><a class="button-secondary" href="<%= localePrefix %>/about"><%= home.aboutLink %></a></div>
    </div>
    <div class="brand-art" data-home-reveal><div class="brand-panel">
      <div class="brand-panel-top"><span class="brand-line" aria-hidden="true"></span><span><%= organization.short_name || name %></span></div>
      <% if(organization.primary_logo) { %><img class="brand-logo feature-logo" src="<%= organization.primary_logo %>" alt="<%= name %>" width="885" height="885" fetchpriority="high"><% } %>
      <div class="brand-panel-bottom"><span><%= name %></span><% if(organization.country) { %><span class="country-mark"><span aria-hidden="true"></span><%= organization.country %></span><% } %></div>
    </div></div>
  </section>

  <section class="home-section home-about page-width" aria-labelledby="home-about-heading" data-home-reveal>
    <div class="home-about-copy"><p class="eyebrow"><%= t.about %></p><h2 id="home-about-heading"><%= contentText(about,'heading',locale)||home.about %></h2>
      <p class="home-lead preserve-lines"><%= homeExcerpt(contentText(about,'introduction',locale),420,locale)||home.empty %></p>
      <a class="text-link" href="<%= localePrefix %>/about"><%= home.aboutLink %><span aria-hidden="true"> →</span></a>
    </div>
    <% const aboutPhoto=about?.images?.[0]; if(aboutPhoto) { %><figure class="home-about-visual"><img src="<%= assetUrl(aboutPhoto.media) %>" alt="<%= contentText(aboutPhoto,'alt_text',locale) %>" width="<%= aboutPhoto.media.width %>" height="<%= aboutPhoto.media.height %>" loading="lazy" decoding="async"></figure><% } %>
  </section>

  <div class="home-services-wrap" data-home-reveal>
    <% if(serviceGroups.length) { %><%- include('services/category-showcase') %><% } else { %><section class="home-section home-services page-width" aria-labelledby="home-services-heading"><header class="home-section-heading"><div><p class="eyebrow"><%= t.services %></p><h2 id="home-services-heading"><%= home.coreActivities %></h2><p class="text-muted"><%= home.coreActivitiesIntro %></p></div></header><p class="text-muted"><%= home.empty %></p><p class="home-work-all"><a class="button-secondary" href="<%= localePrefix %>/services"><%= home.exploreAllActivities %></a></p></section><% } %>
  </div>

  <section class="home-section home-work page-width" aria-labelledby="home-work-heading" data-home-reveal>
    <header class="home-section-heading"><div><p class="eyebrow"><%= programLabels.heading %></p><h2 id="home-work-heading"><%= home.ourWork %></h2><p class="text-muted"><%= home.ourWorkIntro %></p></div></header>
    <% if(!ourWork.length) { %><p class="home-empty"><%= programLabels.empty %></p><% } else { %><div class="home-work-grid"><% for(const [index,work] of ourWork.entries()) { const title=contentText(work,'title',locale); const excerpt=programExcerpt(contentText(work,'full_description',locale),work.description_format,locale,180); %>
      <article class="home-work-card"><% if(work.featured_image) { %><a class="home-work-image" href="<%= localePrefix+'/programs/'+work.slug %>" tabindex="-1" aria-hidden="true"><img src="<%= assetUrl(work.featured_image) %>" alt="" width="<%= work.featured_image.width %>" height="<%= work.featured_image.height %>" loading="lazy" decoding="async"></a><% } else { %><div class="home-work-art" aria-hidden="true"><span>0<%= index+1 %></span></div><% } %>
      <div class="home-work-copy"><p class="eyebrow"><%= programLabels.heading %></p><h3><a href="<%= localePrefix+'/programs/'+work.slug %>"><%= title %></a></h3><% if(excerpt) { %><p><%= excerpt %></p><% } %><a class="text-link" href="<%= localePrefix+'/programs/'+work.slug %>" aria-label="<%= programLabels.read+': '+title %>"><%= programLabels.read %><span aria-hidden="true"> →</span></a></div></article>
    <% } %></div><% } %>
    <p class="home-work-all"><a class="button-secondary" href="<%= localePrefix %>/programs"><%= home.viewAllWork %><span aria-hidden="true"> →</span></a></p>
  </section>

  <% if(about?.statistics?.length) { %><section class="home-section home-impact" aria-labelledby="home-impact-heading" data-home-reveal><div class="page-width"><header class="home-section-heading"><div><p class="eyebrow"><%= t.organization %></p><h2 id="home-impact-heading"><%= home.impact %></h2></div></header><dl class="home-stat-grid"><% for(const statistic of about.statistics) { %><div><dt><%= contentText(statistic,'label',locale) %></dt><dd><%= statistic.value %></dd></div><% } %></dl></div></section><% } %>

  <section class="home-section page-width" aria-labelledby="home-news-heading" data-home-reveal>
    <header class="home-section-heading"><div><p class="eyebrow"><%= t.media %></p><h2 id="home-news-heading"><%= home.news %></h2><p class="text-muted"><%= home.newsIntro %></p></div><a class="text-link" href="<%= localePrefix %>/news"><%= home.allNews %><span aria-hidden="true"> →</span></a></header>
    <% if(!news.length) { %><p class="home-empty"><%= home.empty %></p><% } else { %><div class="home-news-grid"><% for(const story of news) { %><article class="home-news-card">
      <% if(story.featured_image) { %><a class="home-news-image" href="<%= localePrefix+'/news/'+story.slug %>" tabindex="-1" aria-hidden="true"><img src="<%= assetUrl(story.featured_image) %>" alt="" width="<%= story.featured_image.width %>" height="<%= story.featured_image.height %>" loading="lazy" decoding="async"></a><% } %>
      <div class="home-news-copy"><% if(story.published_date) { %><time datetime="<%= dateInput(story.published_date) %>"><%= formatDate(story.published_date) %></time><% } %><h3><a href="<%= localePrefix+'/news/'+story.slug %>"><%= contentText(story,'title',locale) %></a></h3><p><%= homeExcerpt(contentText(story,'summary',locale),200,locale) %></p><a class="text-link" href="<%= localePrefix+'/news/'+story.slug %>" aria-label="<%= home.read+': '+contentText(story,'title',locale) %>"><%= home.read %><span aria-hidden="true"> →</span></a></div>
    </article><% } %></div><% } %>
  </section>

  <section class="home-section home-gallery" aria-labelledby="home-gallery-heading" data-home-reveal><div class="page-width">
    <header class="home-section-heading"><div><p class="eyebrow"><%= t.gallery %></p><h2 id="home-gallery-heading"><%= home.gallery %></h2><p class="text-muted"><%= home.galleryIntro %></p></div><a class="text-link" href="<%= localePrefix %>/gallery"><%= home.allGallery %><span aria-hidden="true"> →</span></a></header>
    <% if(!albums.length) { %><p class="home-empty"><%= home.empty %></p><% } else { %><div class="home-gallery-grid"><% for(const album of albums) { const cover=album.cover_image||album.images[0]?.image; %><a class="home-album <%= cover?'':'home-album-text' %>" href="<%= localePrefix+'/gallery/'+album.id %>">
      <% if(cover) { %><img src="<%= assetUrl(cover) %>" alt="" width="<%= cover.width %>" height="<%= cover.height %>" loading="lazy" decoding="async"><% } %>
      <div class="home-album-copy"><h3><%= contentText(album,'title',locale) %></h3><span><%= home.album %> <span aria-hidden="true">↗</span></span></div></a><% } %></div><% } %>
  </div></section>

  <section class="home-section page-width" aria-labelledby="home-testimonials-heading" data-home-reveal>
    <header class="home-section-heading"><div><p class="eyebrow"><%= t.testimonials %></p><h2 id="home-testimonials-heading"><%= home.testimonials %></h2></div><a class="text-link" href="<%= localePrefix %>/testimonials"><%= home.allTestimonials %><span aria-hidden="true"> →</span></a></header>
    <% if(!testimonials.length) { %><p class="home-empty"><%= home.empty %></p><% } else { %><div class="home-testimonial-grid"><% for(const testimonial of testimonials) { %><figure class="home-quote"><span class="home-quote-mark" aria-hidden="true">“</span><blockquote class="preserve-lines"><%= contentText(testimonial,'testimonial',locale) %></blockquote><figcaption>
      <% if(testimonial.photo) { %><img src="<%= assetUrl(testimonial.photo) %>" alt="" width="<%= testimonial.photo.width %>" height="<%= testimonial.photo.height %>" loading="lazy" decoding="async"><% } %><div><strong><%= contentText(testimonial,'name',locale) %></strong><% if(contentText(testimonial,'position_organization',locale)) { %><p class="text-muted"><%= contentText(testimonial,'position_organization',locale) %></p><% } %></div></figcaption></figure><% } %></div><% } %>
  </section>

  <section class="home-section home-feedback page-width" aria-labelledby="home-feedback-heading" data-home-reveal><div class="home-feedback-panel"><div><p class="eyebrow"><%= contactLabels.feedback %></p><h2 id="home-feedback-heading"><%= home.feedback %></h2><p class="text-muted"><%= home.feedbackIntro %></p></div><a class="button-secondary" href="<%= localePrefix %>/contact#feedback"><%= contactLabels.share %> <span aria-hidden="true">↗</span></a></div></section>
  <section class="home-section home-donate" aria-labelledby="home-donate-heading" data-home-reveal><div class="page-width home-donate-inner"><p class="eyebrow"><%= name %></p><h2 id="home-donate-heading"><%= home.donate %></h2><p class="text-muted"><%= home.donateIntro %></p><a class="button-primary" href="<%= donateUrl %>"><%= home.donateLink %> <span aria-hidden="true">→</span></a></div></section>
</main>
<script src="/assets/js/home.js" defer></script>
<%- include('../partials/footer') %>
