<%- include('../partials/head') %>
<a href="#main" class="skip-link">Skip to content</a>
<main id="main" class="auth-page" tabindex="-1">
  <div class="admin-notice auth-card">
    <a class="identity" href="/"><img class="brand-logo" src="<%= branding.logoUrl %>" width="54" height="54" alt=""><strong>Nahuda Sewa</strong></a>
    <p class="eyebrow mt-6">Admin account</p>
    <h1 class="text-3xl font-bold mt-2">Welcome back</h1>
    <p class="text-muted mt-2">Sign in to your workspace.</p>
    <% if (error) { %><p id="form-error" class="form-alert" role="alert"><%= error %></p><% } %>
    <form method="post" action="/admin/login" class="auth-form" <%= error ? 'aria-describedby=form-error' : '' %>>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="username" maxlength="254" required autofocus>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" maxlength="256" required>
      <button type="submit" class="button-primary mt-4">Sign in</button>
    </form>
    <a href="/" class="text-link block mt-6">Back to the public website</a>
  </div>
</main>
</body></html>
