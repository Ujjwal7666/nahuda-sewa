<%- include('partials/start') %>
<h1 class="text-3xl font-bold mt-2"><%= module.label %></h1>
<% if(module.model==='committeeMember') { %><p class="text-muted mt-3">Names require both languages. Position, committee role, introduction and photo are optional. Choose a branch; only active branches and their active members appear publicly.</p><a class="text-link" href="/admin/committee/branches">Manage branches</a><% } %>
<% if(module.model!=='committeeMember') { %><p class="text-muted mt-3"><%= module.statistic?'Labels require English and नेपाली. The shared value is displayed exactly as entered.':'Bilingual content fields require English and नेपाली. Use plain text; line breaks are preserved. Images are shared across languages.' %><%= module.photo?' Introduction in either language is optional.':'' %><%= module.hero?' The optional hero image and YouTube URL may be left empty. The page heading also serves as the hero heading.':'' %></p><% } %>
<% if(saved) { %><p class="form-alert" role="status">Content saved.</p><% } %>
<% if(errors.length) { %><div class="form-alert" role="alert" id="content-errors"><strong>Content was not saved.</strong><ul><% for(const error of errors) { %><li><a href="#<%= error.key %>"><%= error.message %></a></li><% } %></ul><p>Choose selected files again. Reload if another tab changed this record.</p></div><% } %>
<form class="settings-form" method="post" action="<%= module.path + (!module.singleton && row.id ? '/'+row.id : '') %>" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= revision %>">
  <section class="settings-section"><div class="settings-grid">
  <% if(module.model==='committeeMember') { %><div class="settings-field"><label for="branch_id">Committee branch *</label><select id="branch_id" name="branch_id" required><option value="">Choose branch</option><% for(const branch of branches) { %><option value="<%= branch.id %>" <%= Number(values.branch_id)===branch.id?'selected':'' %>><%= branch.name_en %> / <%= branch.name_ne %><%= branch.is_active?'':' (Inactive)' %></option><% } %></select><p class="field-hint">Existing unassigned members are preserved. Select their correct branch before saving. Create a branch first if none exist.</p></div><% } %>
  <% for(const field of module.fields) { %><div class="settings-field">
    <label for="<%= field.key %>"><%= field.label %><%= field.optional?' (optional)':' *' %></label>
    <% if(field.multiline) { %><textarea id="<%= field.key %>" name="<%= field.key %>" lang="<%= field.lang || 'en' %>" <%= field.optional?'':'required' %> maxlength="<%= field.max %>" rows="5"<% if(errors.some(e=>e.key===field.key)) { %> aria-invalid="true" aria-describedby="content-errors"<% } %>><%= values[field.key]||'' %></textarea><% } else { %><input id="<%= field.key %>" name="<%= field.key %>" lang="<%= field.lang || 'en' %>" <%= field.optional?'':'required' %> maxlength="<%= field.max %>" value="<%= values[field.key]||'' %>"<% if(errors.some(e=>e.key===field.key)) { %> aria-invalid="true" aria-describedby="content-errors"<% } %>><% } %>
  </div><% } %>
  <% if(!module.singleton) { %><div class="settings-field"><label for="display_order">Display Order *</label><input id="display_order" name="display_order" type="number" min="0" max="999999" step="1" required value="<%= values.display_order ?? 0 %>"><p class="field-hint">Lower numbers appear first. Equal numbers use record ID order.</p></div><% } %>
  <% if(module.statistic) { %><div class="settings-field"><label for="kind">Statistic category *</label><select id="kind" name="kind" required><option value="">Choose category</option><% for(const [kind,label] of Object.entries(statisticKinds)) { %><option value="<%= kind %>" <%= values.kind===kind?'selected':'' %>><%= label %></option><% } %></select><p class="field-hint">One statistic per category. Values appear exactly as entered; no totals are calculated.</p></div><% } %>
  <% if(module.hero) { %><div class="settings-field"><label for="youtube_url">YouTube URL (optional)</label><input id="youtube_url" name="youtube_url" type="url" maxlength="2048" value="<%= values.youtube_url||'' %>" aria-describedby="youtube-hint"><p id="youtube-hint" class="field-hint">Use an HTTPS YouTube video URL. Leave empty to hide the video section.</p></div><% } %>
  <% if(module.photo || module.visibility) { %><div class="settings-field"><label for="is_active">Visibility</label><select id="is_active" name="is_active"><option value="0" <%= !values.is_active?'selected':'' %>>Inactive</option><option value="1" <%= values.is_active?'selected':'' %>>Active</option></select><p class="field-hint">Only active entries appear publicly.</p></div><% } %>
  <% if(module.photo || module.image || module.hero) { const asset=row.photo||row.media||row.hero_image; %><div class="settings-asset"><label for="photo"><%= module.hero?'Hero background image (optional)':module.image?'Image *':'Photo (optional)' %></label>
    <% if(asset) { %><img src="<%= assetUrl(asset) %>" width="120" height="120" alt="Current image"><% if(module.photo || module.hero) { %><label class="settings-check"><input type="checkbox" name="clear_photo" value="1">Remove current image</label><% } %><% } %>
    <input id="photo" name="photo" type="file" accept="image/png,image/jpeg,image/webp" <%= module.image&&!asset?'required':'' %> aria-describedby="photo-hint"><p id="photo-hint" class="field-hint">PNG, JPEG or WebP; up to 10 MB and 16 megapixels. Safely converted to PNG.</p>
  </div><% } %>
  </div></section>
  <div class="settings-save"><button class="button-primary" type="submit">Save <%= module.label %></button><a class="text-link" href="<%= module.image?'/admin/organization/about':module.singleton?module.publicPath:module.path %>"><%= module.singleton?'View public page':'Cancel' %></a></div>
</form>
<% if(module.model==='aboutOrganization') { %><section class="settings-section"><h2>About images</h2><p class="text-muted">Add a photo of your organization, building, activities or another relevant subject. The first image by display order replaces the default organization logo panel beside the introduction; other images appear below. Images are optional and need descriptions in both languages. Save the About text before adding images.</p>
  <p class="mt-3"><a class="button-secondary" href="/admin/vision-mission">Edit Vision &amp; Mission</a> <a class="button-secondary" href="/admin/organization/about/statistics">Manage About statistics</a></p>
  <% if(row.id) { %><a class="button-secondary" href="/admin/organization/about/images/new">Add organization photo</a><div class="content-admin-list"><% for(const image of images) { %><article><img src="<%= assetUrl(image.media) %>" width="120" height="120" alt="<%= image.alt_text_en %>"><p><%= image.alt_text_en %> / <span lang="ne"><%= image.alt_text_ne %></span></p><p>Order: <%= image.display_order %></p><a class="text-link" href="/admin/organization/about/images/<%= image.id %>/edit">Edit</a> · <a class="text-link" href="/admin/organization/about/images/<%= image.id %>/delete">Delete</a></article><% } %></div><% } %>
</section><% } %>
<%- include('partials/end') %>
