<% if(module.asset) { %><div class="settings-asset"><label for="photo"><%= {featured_image:'Featured image',cover_image:'Cover image',photo:'Photo',media:'Additional image',image:['serviceImage','programImage'].includes(module.model)?'Supporting image':'Album image'}[module.asset] %><%= module.requiredImage?' *':' (optional)' %><% if(module.service && module.asset==='featured_image') { %> [Hero: at least 1200 × 600 px; shown on desktop/tablet only. Smaller images remain available for listing cards.]<% } %></label>
<% if(row[module.asset]) { %><img src="<%= assetUrl(row[module.asset]) %>" width="120" height="120" alt="Current image"><% if(!module.requiredImage) { %><label class="settings-check"><input type="checkbox" name="clear_photo" value="1">Remove current image</label><% } } %>
<input id="photo" name="photo" type="file" accept="image/png,image/jpeg,image/webp" <%= module.requiredImage&&!row[module.asset]?'required':'' %>><p class="field-hint">PNG, JPEG or WebP; up to 10 MB and 16 megapixels. Safely converted to PNG.<%= module.asset==='cover_image'?' Without a cover, the first ordered album image is used.':'' %></p></div>
<% } %>
