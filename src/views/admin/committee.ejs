<%- include('partials/start') %>
<h1 class="text-3xl font-bold mt-2">Committee</h1>
<p class="text-muted mt-3">Create branches, then manage each branch’s members. Lower display orders appear first; ties use record ID. Only active branches and active assigned members appear publicly.</p>
<% if(saved) { %><p class="form-alert" role="status">Changes saved.</p><% } %>
<div class="content-actions mt-6"><a class="button-primary" href="/admin/committee/branches/new">Add branch</a><a class="button-secondary" href="/admin/committee/branches">Manage branches</a><a class="button-secondary" href="/admin/committee/new<%= filter && filter!=='unassigned'?'?branch='+filter:'' %>">Add member</a><a class="text-link" href="/about/committee">View public page</a></div>
<section class="settings-section"><h2>Branches</h2>
<div class="content-admin-list"><% for(const branch of branches) { %><article><h3><%= branch.name_en %> / <span lang="ne"><%= branch.name_ne %></span></h3><p><%= branch._count.members %> members · <%= branch.is_active?'Active':'Inactive' %> · Order: <%= branch.display_order %></p><div class="content-actions"><a class="text-link" href="?branch=<%= branch.id %>">View members</a><a class="text-link" href="/admin/committee/new?branch=<%= branch.id %>">Add member</a><a class="text-link" href="/admin/committee/branches/<%= branch.id %>/edit">Edit branch</a><a class="text-link" href="/admin/committee/branches/<%= branch.id %>/delete">Delete branch</a></div></article><% } %></div>
<% if(!branches.length) { %><p class="form-alert">No branches yet. Create your first branch above.</p><% } %></section>
<section class="settings-section"><h2>Members</h2>
<form method="get" action="/admin/committee" class="settings-field"><label for="branch-filter">Filter by branch</label><select id="branch-filter" name="branch"><option value="" <%= !filter?'selected':'' %>>All members</option><option value="unassigned" <%= filter==='unassigned'?'selected':'' %>>Unassigned — requires review</option><% for(const branch of branches) { %><option value="<%= branch.id %>" <%= filter===String(branch.id)?'selected':'' %>><%= branch.name_en %></option><% } %></select><button class="button-secondary mt-3" type="submit">Show members</button></form>
<% if(!rows.length) { %><p class="form-alert">No members in this view.</p><% } %>
<div class="content-admin-list"><% for(const member of rows) { %><article><% if(member.photo) { %><img src="<%= assetUrl(member.photo) %>" width="100" height="100" alt="<%= member.name_en %>"><% } %><h3><%= member.name_en %> / <span lang="ne"><%= member.name_ne %></span></h3><% if(member.position_en) { %><p><%= member.position_en %></p><% } %><p>Branch: <%= member.branch?.name_en || 'Unassigned — select a branch before saving' %></p><p><%= member.is_active?'Active':'Inactive' %> · Order within branch: <%= member.display_order %></p><div class="content-actions"><a class="text-link" href="/admin/committee/<%= member.id %>/edit">Edit / move member</a><a class="text-link" href="/admin/committee/<%= member.id %>/delete">Delete</a></div></article><% } %></div></section>
<%- include('partials/end') %>
