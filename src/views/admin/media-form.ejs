<%- include('partials/start') %>
<h1 class="text-3xl font-bold"><%= module.label %></h1>
<p class="text-muted mt-3">Edit both languages on one record. Fields marked * are required; supporting text is independently optional. <%= (module.service || module.program)?'Full descriptions support structured articles; other fields use plain text.':'Use plain text.' %> Images are shared.</p>
<% if(errors.length) { %><div class="form-alert" role="alert" id="media-errors"><strong>Content was not saved.</strong><ul><% for(const error of errors) { %><li><a href="#<%= module.program && error.key.startsWith('additional_')?'additional_combined_'+error.key.slice(-2):error.key %>"><%= error.message %></a></li><% } %></ul><p>Select files again. Reload if another tab changed this record.</p></div><% } %>
<form class="settings-form" method="post" action="<%= path+(row.id?'/'+row.id:'') %>" enctype="multipart/form-data">
<% if(module.service || module.program) { %><input type="hidden" id="description_format" name="description_format" value="<%= values.description_format||'PLAIN' %>"><% } %>
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= revision %>">
<section class="settings-section"><div class="settings-grid">
<% for(const [index,field] of module.fields.entries()) { if(module.program && field.key.startsWith('additional_')) continue; if((module.service || module.program) && field.group==='Detailed content' && module.fields[index-1]?.group==='Basic information') { %><%- include('service-slug') %><% } if(field.group && field.group!==module.fields[index-1]?.group) { %><h2 class="settings-group-heading"><%= field.group %></h2><% } %><div class="settings-field <%= field.richText?'activity-editor-row':'' %>"><% if(!field.richText) { %><label for="<%= field.key %>"><%= field.label %><%= field.optional?' (optional)':' *' %></label><% } %>
<% if(field.richText) { %><%- include('activity-editor',{field}) %><% } else if(field.multiline) { %><textarea id="<%= field.key %>" name="<%= field.key %>" lang="<%= field.lang %>" <% if(errors.some(error=>error.key===field.key)) { %>aria-invalid="true" aria-describedby="media-errors"<% } %> <%= field.optional?'':'required' %> maxlength="<%= field.max %>" rows="5"><%= values[field.key]||'' %></textarea><% if(module.service && field.key.startsWith('short_description_')) { %><p class="field-hint">Tailored introduction for listing cards and previews; omitted from the activity detail article.</p><% } %><% } else { %><input id="<%= field.key %>" name="<%= field.key %>" lang="<%= field.lang %>" <% if(errors.some(error=>error.key===field.key)) { %>aria-invalid="true" aria-describedby="media-errors"<% } %> <%= field.optional?'':'required' %> maxlength="<%= field.max %>" value="<%= values[field.key]||'' %>"><% } %></div><% } %>
<% if(module.program) { %><%- include('program-information-editor') %><% } %>
<% if(module.news) { %><div class="settings-field"><label for="slug">Slug *</label><input id="slug" name="slug" required maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="<%= values.slug||'' %>" <%= row.slug_locked?'readonly':'' %>><p class="field-hint">Automatically filled from the English title. You can edit it before publication; clearing it resumes automatic suggestions on the next title change. Shared EN/NE URL. Lowercase letters, numbers and hyphens. Locked permanently after first publication.</p></div><div class="settings-field"><label for="status">Status</label><select id="status" name="status"><option value="DRAFT" <%= values.status!=='PUBLISHED'?'selected':'' %>>Draft</option><option value="PUBLISHED" <%= values.status==='PUBLISHED'?'selected':'' %>>Published</option></select></div><% } %>
<% if(module.date) { %><div class="settings-field"><label for="<%= module.date %>"><%= module.news?'Published Date (required when Published)':'Album Date (optional)' %></label><input id="<%= module.date %>" name="<%= module.date %>" type="date" min="1900-01-01" max="9999-12-31" value="<%= dateInput(values[module.date]) %>"><p class="field-hint">Gregorian editorial date. Newest first; this does not schedule publication.</p></div><% } %>
<% if(module.service) { %><%- include('media-asset') %><% } %>
<% if(module.slug && !module.program) { %><%- include('service-slug') %><% } %>
<% if(module.service) { %><h2 class="settings-group-heading">Display settings</h2>
<fieldset class="activity-position-settings"><legend>Featured image position</legend><div class="activity-setting-options"><% for(const [position,label] of [['DEFAULT','Default (centered above article)'],['LEFT','Left of description'],['RIGHT','Right of description'],['TOP','Top of description'],['FULL','Full content width']]) { %><label><input type="radio" name="image_position" value="<%= position %>" <%= (values.image_position||'DEFAULT')===position?'checked':'' %>><span><%= label %></span></label><% } %></div><p class="field-hint">Left and right images stack above the description on smaller screens. Full width preserves the complete photo.</p></fieldset><div class="settings-field"><label for="category_id">Category (optional)</label><select id="category_id" name="category_id"><option value="">No category</option><% for(const category of serviceCategories) { %><option value="<%= category.id %>" <%= Number(values.category_id)===category.id?'selected':'' %>><%= category.name_en %> / <%= category.name_ne %><%= category.is_active?'':' (inactive label)' %></option><% } %></select><a class="text-link" href="/admin/service-categories">Manage categories</a></div><div class="settings-field"><label for="is_featured">Featured on Homepage</label><select id="is_featured" name="is_featured"><option value="0" <%= !values.is_featured?'selected':'' %>>No</option><option value="1" <%= values.is_featured?'selected':'' %>>Yes</option></select><p class="field-hint">Eligible for the Homepage when active.</p></div><% } %>
<% if(module.ordered) { %><div class="settings-field"><label for="display_order">Display Order *</label><input id="display_order" name="display_order" type="number" min="0" max="999999" step="1" required value="<%= values.display_order??0 %>"><p class="field-hint">Lower numbers first; ties use record ID.</p></div><% } %>
<% if(module.visibility) { %><div class="settings-field"><label for="is_active"><%= module.service||module.program?'Publication status':'Visibility' %></label><select id="is_active" name="is_active"><option value="0" <%= !values.is_active?'selected':'' %>><%= module.service||module.program?'Unpublished':'Inactive' %></option><option value="1" <%= values.is_active?'selected':'' %>><%= module.service||module.program?'Published':'Active' %></option></select></div><% } %>
<% if(!module.service) { %><%- include('media-asset') %><% } %></div></section><div class="settings-save"><button class="button-primary" type="submit">Save</button><a class="button-secondary" href="<%= path %>">Cancel</a></div></form>
<% if(row.images) { %><section class="settings-section"><h2><%= (module.service||module.program)?'Optional supporting images':module.news?'Optional additional images':'Album Images' %> (<%= row.images.length %>)</h2><p><%= (module.service||module.program)?'Add as many supporting images as needed, including two or more. Each image has its own display order and optional EN/NE caption and alt text. The gallery appears after the article.':'Images appear automatically in display order.' %> Image changes also update this record; reload the parent form before saving again.</p><% if(module.model==='galleryAlbum') { %><a class="button-primary mt-3" href="<%= path %>/<%= row.id %>/images/add">Add Images</a><a class="button-secondary mt-3" href="<%= path %>/<%= row.id %>/images">Manage Album Images</a><% if(!row.images.length) { %><p class="form-alert">No album photos yet. The cover is separate from the album's photo collection.</p><% } %><%- include('gallery-image-grid',{galleryImages:row.images,imagePath:path+'/'+row.id+'/images'}) %><% } else { %><% if(module.service||module.program) { %><a class="button-primary mt-3" href="<%= path %>/<%= row.id %>/images/new">Add supporting image</a><% } %><a class="button-secondary mt-3" href="<%= path %>/<%= row.id %>/images">Manage images (<%= row.images.length %>)</a><% } %></section><% } else if(module.program) { %><section class="settings-section"><h2>Supporting images</h2><p>Save this Our Work item first, then add multiple supporting photos with optional English/Nepali captions, alt text and display order.</p></section><% } else if(module.model==='galleryAlbum') { %><section class="settings-section"><h2>Album Images</h2><p>Save this album first, then add multiple photos to it. The optional cover represents the event; it does not replace the album's image collection.</p></section><% } %>
<% if(module.service) { %><section class="settings-section"><h2>What we provide / Features</h2><p>Save this activity first, then add any number of features or gallery images. Reload this form after changing children.</p><% if(row.id) { %><a class="button-primary mt-3" href="<%= path %>/<%= row.id %>/features/new">Add Feature</a><a class="button-secondary mt-3" href="<%= path %>/<%= row.id %>/features">Manage features (<%= row.features?.length||0 %>)</a><% } %></section><% } %>
<% if(module.service || module.program) { %><script src="/assets/js/activity-editor.js" defer></script><% } %>
<% if(module.news || module.service || module.slug) { %><script src="/assets/js/news-slug.js" defer></script><% } %>
<%- include('partials/end') %>
