<%- include('partials/start') %>
<h1 class="text-3xl font-bold">Our Work content preview</h1>
<p class="text-muted mt-3"><%= row.is_active?'Active — publicly visible':'Inactive — visible only in Admin' %> · Order: <%= row.display_order %></p>
<p class="mt-3"><a class="button-primary" href="<%= path+'/'+row.id+'/edit' %>">Edit Our Work</a> <a class="button-secondary" href="<%= path %>">All Our Work</a><% if(row.is_active) { %> <a class="text-link" href="<%= '/programs/'+row.slug %>">View public page</a><% } %></p>
<% if(row.featured_image) { %><figure class="program-preview-photo settings-section"><a href="<%= assetUrl(row.featured_image) %>"><img src="<%= assetUrl(row.featured_image) %>" alt="<%= row.title_en %>" width="<%= row.featured_image.width %>" height="<%= row.featured_image.height %>"></a></figure><% } %>
<% if(row.images?.length) { %><section class="settings-section"><h2>Supporting images</h2><a class="text-link" href="<%= path+'/'+row.id+'/images' %>">Manage images (<%= row.images.length %>)</a><% for(const photo of row.images) { %><figure><img src="<%= assetUrl(photo.image) %>" alt="<%= photo.alt_text_en||row.title_en %>" width="240" loading="lazy"><figcaption><%= photo.caption_en %> / <span lang="ne"><%= photo.caption_ne %></span></figcaption></figure><% } %></section><% } %>
<% for(const language of ['en','ne']) { %><section class="settings-section program-preview" lang="<%= language %>"><p class="eyebrow"><%= language==='en'?'English':'नेपाली' %></p><h2><%= row['title_'+language] %></h2><div class="activity-editor program-preview-body"><%- activityDescription(row['full_description_'+language],row.description_format) %></div>
<% if(row.additional_format==='HTML' && row['additional_content_'+language]) { %><div class="activity-prose"><%- activityDescription(row['additional_content_'+language],'HTML') %></div><% } else if(row['additional_heading_'+language] && row['additional_content_'+language]) { %><h3><%= row['additional_heading_'+language] %></h3><p class="preserve-lines"><%= row['additional_content_'+language] %></p><% } %></section><% } %>
<%- include('partials/end') %>
