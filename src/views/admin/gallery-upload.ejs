<%- include('partials/start') %>
<h1 class="text-3xl font-bold">Add Album Images</h1>
<p class="mt-3"><strong><%= album.title_en %></strong> / <span lang="ne"><%= album.title_ne %></span></p>
<p class="text-muted mt-3">Select up to <%= galleryBatchLimit %> photos at once. Add more batches to this same album whenever needed. These descriptions, optional captions and credits apply to the selected photos; edit each photo individually afterwards for specific details.</p>
<% if(errors.length) { %><div class="form-alert" role="alert" id="gallery-upload-errors"><strong>No photos were added.</strong><ul><% for(const error of errors) { %><li><%= error.message %></li><% } %></ul><p>Select the photos again before retrying.</p></div><% } %>
<form class="settings-form" method="post" action="<%= path %>/batch" enctype="multipart/form-data" data-gallery-upload>
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= album.revision %>">
<section class="settings-section"><div class="settings-field"><label for="photos">Photos *</label><input id="photos" name="photos" type="file" accept="image/png,image/jpeg,image/webp" multiple required data-gallery-files data-max-files="<%= galleryBatchLimit %>"><p class="field-hint">PNG, JPEG or WebP; up to 10 MB and 16 megapixels per photo. The whole batch is saved together; if one photo fails validation, none are added. Your album can contain any number of photos across uploads.</p><p role="status" data-gallery-selection></p><div class="gallery-admin-grid" data-gallery-previews></div></div></section>
<section class="settings-section"><div class="settings-grid"><% for(const field of module.fields) { %><div class="settings-field"><label for="<%= field.key %>"><%= field.label %><%= field.optional?' (optional)':' *' %></label><% if(field.multiline) { %><textarea id="<%= field.key %>" name="<%= field.key %>" lang="<%= field.lang %>" maxlength="<%= field.max %>" <%= field.optional?'':'required' %> rows="3"><%= values[field.key]||'' %></textarea><% } else { %><input id="<%= field.key %>" name="<%= field.key %>" lang="<%= field.lang %>" maxlength="<%= field.max %>" <%= field.optional?'':'required' %> value="<%= values[field.key]||'' %>"><% } %></div><% } %><div class="settings-field"><label for="display_order">Starting display order *</label><input id="display_order" name="display_order" type="number" min="0" max="999999" step="1" required value="<%= values.display_order??0 %>"><p class="field-hint">Photos receive consecutive orders in selection order. Adjust each order after uploading.</p></div></div></section>
<div class="settings-save"><button class="button-primary" type="submit">Upload images</button><a class="button-secondary" href="<%= path %>">Back to Album Images</a></div></form>
<script src="/assets/js/gallery-admin.js" defer></script>
<%- include('partials/end') %>
