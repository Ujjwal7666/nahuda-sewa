<%- include('partials/start') %>
<h1 class="text-3xl font-bold mt-3">Donation Receipts</h1><p class="text-muted mt-2">Review receipts submitted by donors. Reviewed is a tracking status, not payment verification.</p>
<form method="get" class="receipt-filter"><label for="status">Status</label><select id="status" name="status"><option value="">All</option value="NEW" <%= status==='NEW'?'selected':'' %>>New</option><option value="REVIEWED" <%= status==='REVIEWED'?'selected':'' %>>Reviewed</option></select><button class="button-secondary">Filter</button></form>
<p class="text-muted"><%= count %> submissions</p>
<div class="receipt-list"><% for (const row of rows) { %><article class="donate-card"><div><span class="receipt-badge"><%= row.status %></span><h2><a class="text-link" href="/admin/messages/donation-receipts/<%= row.id %>"><%= row.full_name %> →</a></h2><p><%= row.email %></p></div><dl><dt>Donation</dt><dd><%= row.currency %> <%= row.donation_amount.toFixed(2) %> · <%= row.donation_date.toISOString().slice(0,10) %></dd><dt>Submitted (UTC)</dt><dd><%= row.created_at.toISOString().replace('T',' ').slice(0,19) %></dd></dl></article><% } %></div>
<% if (!rows.length) { %><p class="form-alert">No receipts to show.</p><% } %>
<nav class="receipt-pagination" aria-label="Receipt pages"><% if(page>1) { %><a class="text-link" href="?page=<%= page-1 %>&amp;status=<%= status %>">← Previous</a><% } %><span>Page <%= page %></span><% if(page*20<count) { %><a class="text-link" href="?page=<%= page+1 %>&amp;status=<%= status %>">Next →</a><% } %></nav>
<%- include('partials/end') %>
