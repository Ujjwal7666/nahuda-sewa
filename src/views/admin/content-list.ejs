<%- include('partials/start') %>
<h1 class="text-3xl font-bold mt-2"><%= module.label %></h1>
<% if(module.model==='committeeBranch') { %><p class="mt-3"><a class="text-link" href="/admin/committee">Back to Committee members</a></p><% } %>
<p class="text-muted mt-3"><%= module.model==='committeeBranch'?'Manage bilingual branches, member assignments and visibility.':module.statistic?'Manage the four About statistics. Labels use both languages; values are displayed exactly as entered.':'Manage bilingual members.' %> Public pages show active entries in display order.</p>
<% if(saved) { %><p class="form-alert" role="status">Changes saved.</p><% } %>
<a class="button-primary mt-6" href="<%= module.path %>/new">Add <%= module.model==='committeeBranch'?'branch':module.statistic?'statistic':module.model==='lifeMember'?'life member':module.label==='Team'?'team member':'committee member' %></a>
<a class="button-secondary mt-6" href="<%= module.publicPath %>">View public page</a>
<% if(module.statistic) { %><a class="text-link" href="/admin/organization/about">Back to About content</a><% } %>
<% if(!rows.length) { %><p class="form-alert">No <%= module.model==='committeeBranch'?'branches':module.statistic?'statistics':'members' %> added yet.</p><% } %>
<div class="content-admin-list"><% for(const row of rows) { %><article>
  <% if(row.photo) { %><img src="<%= assetUrl(row.photo) %>" width="100" height="100" alt="<%= row.name_en %>"><% } %>
  <h2><%= row.name_en||row.label_en %> / <span lang="ne"><%= row.name_ne||row.label_ne %></span></h2><p><%= module.statistic?row.value:row.designation_en||row.position_en %></p>
  <% if(row.committee_role_en) { %><p><%= row.committee_role_en %></p><% } %><p><strong><%= row.is_active?'Active':'Inactive' %></strong> · Order: <%= row.display_order %></p>
  <% if(module.model==='committeeBranch') { %><p><%= row._count.members %> members</p><p><a class="text-link" href="/admin/committee?branch=<%= row.id %>">View members</a> · <a class="text-link" href="/admin/committee/new?branch=<%= row.id %>">Add member</a></p><% } %>
  <div class="content-actions"><a class="text-link" href="<%= module.path %>/<%= row.id %>/edit">Edit</a><a class="text-link" href="<%= module.path %>/<%= row.id %>/delete">Delete</a></div>
</article><% } %></div>
<%- include('partials/end') %>
