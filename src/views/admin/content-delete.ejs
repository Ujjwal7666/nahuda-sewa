<%- include('partials/start') %>
<h1 class="text-3xl font-bold mt-2">Delete <%= module.label %>?</h1>
<% if(module.model==='committeeBranch') { %><p class="form-alert">This branch contains <%= row._count.members %> members (including inactive members). Move or delete all members first. Branch deletion never deletes members.</p><a class="text-link" href="/admin/committee?branch=<%= row.id %>">Manage these members</a><% } %>
<p class="mt-3">This will remove <strong><%= row.name_en||row.alt_text_en||row.label_en %></strong><%= module.statistic||module.model==='committeeBranch'?'':' and its unreferenced image' %>. This cannot be undone.</p>
<form method="post" action="<%= module.path %>/<%= row.id %>/delete" class="mt-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= row.revision %>">
  <button class="button-primary" type="submit">Delete</button><a class="button-secondary" href="<%= module.image?'/admin/organization/about':module.path %>">Cancel</a>
</form>
<%- include('partials/end') %>
