<%- include('partials/start') %>
<h1 class="text-3xl font-bold mt-3">Change password</h1>
<div class="admin-notice mt-8">
  <p id="password-policy" class="text-muted"><%= passwordPolicy %> Other sessions will be signed out after this change.</p>
  <% if (error) { %><p id="form-error" class="form-alert" role="alert"><%= error %></p><% } %>
  <form method="post" action="/admin/account/change-password" class="auth-form" aria-describedby="password-policy<%= error ? ' form-error' : '' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="current_password">Current password</label>
    <input id="current_password" name="current_password" type="password" autocomplete="current-password" maxlength="256" required>
    <label for="new_password">New password</label>
    <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required>
    <label for="confirm_password">Confirm new password</label>
    <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required>
    <button type="submit" class="button-primary mt-4">Update password</button>
  </form>
</div>
<%- include('partials/end') %>
