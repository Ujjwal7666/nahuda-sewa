  @@map("about_images")
}

model AboutStatistic {
  id Int @id @default(autoincrement())
  revision Int @default(1)
  kind String @unique @db.VarChar(32)
  label_en String @db.VarChar(100)
  label_ne String @db.VarChar(100)
  value String @db.VarChar(40)
  display_order Int @default(0)
  is_active Boolean @default(false)
  about_id Int @default(1)
  about AboutOrganization @relation(fields: [about_id], references: [id], onDelete: Restrict)
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @updatedAt @db.DateTime(3)
  @@index([about_id, is_active, display_order, id])
  @@map("about_statistics")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

model News {
  id Int @id @default(autoincrement())
  revision Int @default(1)
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @updatedAt @db.DateTime(3)
  title_en String @db.VarChar(200)
  title_ne String @db.VarChar(200)
  summary_en String @db.Text
  summary_ne String @db.Text
  content_en String @db.Text
  content_ne String @db.Text
  featured_image_id Int?
  featured_image MediaAsset? @relation(fields: [featured_image_id], references: [id], onDelete: Restrict)
  slug String @unique @db.VarChar(120)
  slug_locked Boolean @default(false)
  published_date DateTime? @db.Date
  status NewsStatus @default(DRAFT)
  images NewsImage[]
  @@index([status, published_date, id])
  @@map("news")
}

