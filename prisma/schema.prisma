  hero_image_id Int?
  hero_image MediaAsset? @relation("about_hero", fields: [hero_image_id], references: [id], onDelete: Restrict)
  youtube_url String? @db.VarChar(100)
  statistics AboutStatistic[]
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @updatedAt @db.DateTime(3)
  @@map("about_organization")
